{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://assessment-harness/source_manifest.schema.json",
  "title": "Source Manifest",
  "description": "Immutable snapshot manifest of assessment source documents (spec, rubric). Phase 0 grounding without DB/RAG.",
  "type": "object",
  "required": ["project_id", "assessment_version", "documents"],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "assessment_version": { "type": "string", "minLength": 1 },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "document": {
      "type": "object",
      "required": ["document_id", "role", "path", "sha256"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "role": {
          "type": "string",
          "enum": ["candidate_spec", "evaluator_rubric", "supplementary"]
        },
        "path": { "type": "string", "minLength": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      },
      "additionalProperties": true
    }
  }
}
